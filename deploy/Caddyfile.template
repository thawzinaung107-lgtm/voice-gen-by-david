# Proposed hostname only. Do not install before DNS/ownership approval.
# Host Caddy reads a release-specific static directory; API binds loopback.
voicegen.atbd.space {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
	@api path /api /api/*
	handle @api {
		reverse_proxy 127.0.0.1:18787
	}
	handle {
		root * /srv/voicegen/current/dist
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
		format json
	}
}
