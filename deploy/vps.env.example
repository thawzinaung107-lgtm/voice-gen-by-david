# Copy outside the checkout. chmod 0600. Do not commit filled values.
# Postgres and MinIO stay on loopback. Do not publish them.
AUTH_MODE=local
DATABASE_URL=postgresql+psycopg://voicegen_runtime:CHANGE_ME@127.0.0.1:5432/voicegen
WORKER_DATABASE_URL=postgresql+psycopg://voicegen_jobs:CHANGE_ME@127.0.0.1:5432/voicegen
APP_ORIGIN=https://CHANGE_ME
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=voicegen-private
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
CREDIT_PER_CHARACTER=1
SUPPLIER_ENABLED=false
